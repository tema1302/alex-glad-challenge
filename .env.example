# Скопируйте в .env и заполните. Читается всеми днями через @challenge/core.
# Приоритет: OPENROUTER_API_KEY предпочтительнее, даёт доступ к десяткам моделей.

# OpenRouter (рекомендуется): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Опционально — модель по умолчанию для OpenRouter:
# OPENROUTER_MODEL=google/gemini-3.5-flash

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Telegram (для напоминаний day-18)
TG_BOT_TOKEN=
TG_CHAT_ID=
