# Скопируйте в .env и заполните. Читается всеми днями через @challenge/core.
# Приоритет: OPENROUTER_API_KEY предпочтительнее, даёт доступ к десяткам моделей.

# OpenRouter (рекомендуется): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Опционально — модель по умолчанию для OpenRouter:
# OPENROUTER_MODEL=google/gemini-3.5-flash

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Telegram-бот для публикации постов канала «Иди на факты глянь»
TG_BOT_TOKEN=
TG_CHAT_ID=

# Прокси для доступа к Telegram (если заблокирован в сети):
# HTTPS_PROXY — для fetch (Bot API), TG_SOCKS_PROXY — для gram.js (MTProto).
HTTPS_PROXY=http://127.0.0.1:10808
TG_SOCKS_PROXY=socks5://127.0.0.1:10808

# Telegram MTProto (Client API): https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=
