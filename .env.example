# Скопируйте в .env и заполните. Читается всеми днями через @challenge/core.
# Приоритет: OPENROUTER_API_KEY предпочтительнее, даёт доступ к десяткам моделей.

# OpenRouter (рекомендуется): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Опционально — модель по умолчанию для OpenRouter:
# OPENROUTER_MODEL=google/gemini-3.5-flash

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Telegram (для напоминаний day-18)
TG_BOT_TOKEN=
TG_CHAT_ID=

# Прокси для Telegram (если API заблокирован)
# HTTP-прокси (например gost → socks5): http://localhost:3128
# HTTPS_PROXY=http://localhost:3128

# Час ежедневной сводки pending-задач в Telegram (0–23, по умолчанию 9)
# SUMMARY_HOUR=9

# Telegram MTProto (day-19: скан истории чата). Bot API не умеет читать историю —
# нужен userbot. api_id/api_hash: my.telegram.org → Apps. session — строка из
# одноразового логина (StringSession), кладётся сюда для 24/7-сервера.
# TG_SESSION можно не задавать — тогда читается из challenge/.data/tg-session.json.
TG_API_ID=
TG_API_HASH=
TG_SESSION=

# --- Локальные модели (дни 21+). С 21-го дня ОБЯЗАТЕЛЬНО только локальные модели,
#     внешние провайдеры выше (DeepSeek/OpenRouter) в RAG НЕ используются.
#     OpenAI-совместимые эндпоинты локального сервера (Ollama: http://localhost:11434/v1,
#     LM Studio: http://localhost:1234/v1, vLLM и т.п.).
# LLM (RAG-ответы):
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
# Ключ обычно не нужен для локального сервера (можно оставить пустым):
LOCAL_LLM_API_KEY=
# Эмбеддинги (часто тот же сервер, отдельная модель):
LOCAL_EMBED_BASE_URL=http://localhost:11434/v1
LOCAL_EMBED_MODEL=
LOCAL_EMBED_API_KEY=
# Стратегия chunking для RAG-запросов по умолчанию (fixed | structure):
# RAG_STRATEGY=fixed

# --- Приватный LLM-gateway (day-30). Тонкий OpenAI-compat прокси поверх локального
#     бэкенда выше (LOCAL_LLM_BASE_URL) с политиками: auth, rate-limit (RPS+TPM),
#     concurrency-семaфор, max-context-tokens. Bind — только 127.0.0.1.
#     На проде: (1) BACKEND vLLM на VPS; (2) GATEWAY этот файл; (3) PUBLIC EDGE
#     reverse-proxy (nginx/Caddy) терминирует TLS + внешний auth. Multi-node LB,
#     distributed rate-limit (Redis), HA — вне репо.
# Auth: отдельный домен от MCP_AUTH_TOKEN. Без токена — открытый режим (только loopback).
# PRIVATE_LLM_AUTH_TOKEN=
# Порт bind на loopback (по умолчанию 3030):
# PRIVATE_LLM_PORT=3030
# Rate-limits: requests/sec и completion-tokens/min (по умолчанию 5 и 10000):
# PRIVATE_LLM_RATE_RPS=5
# PRIVATE_LLM_RATE_TPM=10000
# Concurrency-кап (активных запросов к upstream; очередь = cap × 2):
# PRIVATE_LLM_MAX_CONCURRENCY=4
# Cap prompt-токенов на запрос (utf8-bytes/4; >cap → 413):
# PRIVATE_LLM_MAX_CONTEXT_TOKENS=3500

# --- Admin-auth web/ (day 36). Логин одного админа для всех страниц/API web/,
#     кроме публичного лендинга / и /login. Auth включается ТОЛЬКО когда заданы
#     ОБЕ переменные (иначе fail-closed: всё кроме / ведёт на /login).
#     WEB_AUTH_SECRET — случайная строка ≥32 символов (HMAC-подпись cookie-сессии):
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEB_ADMIN_PASSWORD=
# WEB_AUTH_SECRET=
